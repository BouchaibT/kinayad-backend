# ---------------------------------------------------------------------------
# Kinayad — configuration via variables d'environnement
# Copier en .env pour le dev local :  cp .env.example .env
# Pour Render : ces valeurs se renseignent dans le Blueprint render.yaml,
# pas dans un fichier .env local (ne jamais committer .env).
# ---------------------------------------------------------------------------

# ---- Base de données ----------------
# Local (SQLite) :
DATABASE_URL=sqlite:///./kinayad.db
# Postgres (prod) — Render fournit automatiquement l'URL interne en var DATABASE_URL
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST:5432/kinayad

# ---- Meta / WhatsApp Cloud API -------
META_GRAPH_VERSION=v19.0
META_API_URL=https://graph.facebook.com

# ---- Evolution API (WhatsApp Web auto-hébergé — canal recommandé) ----
# URL de votre instance Evolution API (ex. https://evolution.exemple.com)
EVOLUTION_API_URL=
# Clé API globale de votre serveur Evolution API
EVOLUTION_API_KEY=

# ---- Mot de passe du tableau de bord public (en-tête X-Dashboard-Key) ----
DASHBOARD_PASSWORD=

# ---- Sécurité interne (API protégée / CORS) ----
# API_KEYS est une liste ; en env, séparer par virgule (pydantic-settings la parse)
API_KEYS=dev-secret-kinayad
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://votre-frontend.onrender.com

# ---- Rappels (heures avant le RDV) ----
REMINDER_24H_HOURS=24
REMINDER_2H_HOURS=2

# ---- Worker ----
WORKER_POLL_INTERVAL_SECONDS=15
REMINDER_MAX_ATTEMPTS=3

# ---- Chiffrement du token whatsapp (clé AES-256 en base64) ----
# Générer une clé :  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY_B64=
CAMK_SECRET_KEY=

# ---- Mode démo (ne fait JAMAIS d'appel Meta réel) ----
DEMO_MODE=true
DEMO_PHONE=+212600000000

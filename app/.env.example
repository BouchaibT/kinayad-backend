# ─────────────────────────────────────────────────────────────────────────────
# Kinayad — Backend configuration (env)
# Copiez ce fichier en `.env` (ou exportez ces variables dans votre shell)
# et adaptez chaque valeur à votre environnement.
# ─────────────────────────────────────────────────────────────────────────────

# --- Base de données (PostgreSQL ou SQLite pour le prototypage) ---
# PostgreSQL :
# DATABASE_URL=postgresql+psycopg://kinayad:kinayad@localhost:5432/kinayad
# SQLite (prototypage local, aucun serveur requis) :
# DATABASE_URL=sqlite:///./kinayad.db
DATABASE_URL=postgresql+psycopg://kinayad:kinayad@localhost:5432/kinayad

# --- Meta / WhatsApp Cloud API ---
META_GRAPH_VERSION=v19.0
META_API_URL=https://graph.facebook.com
# App partagée Kinayad (le token/phone est géré par tenant — voir démo par défaut)
META_APP_ID=
META_APP_SECRET=
# Token de vérification du webhook (GET) utilisé par Meta lors de l'abonnement
META_VERIFY_TOKEN=kinayad_verify_change_me
# Secret utilisé pour vérifier la signature X-Hub-Signature-256 des POST webhook
META_WEBHOOK_SECRET=change_me_webhook

# --- Sécurité interne (API protégée / CORS) ---
# Liste d'API keys acceptées (séparées par des virgules)
API_KEYS=dev-secret-kinayad
# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rappels (heures avant le RDV) ---
REMINDER_24H_HOURS=24
REMINDER_2H_HOURS=2

# --- Worker ---
# Secondes entre deux polls de la file de rappels
WORKER_POLL_INTERVAL_SECONDS=15
# Nombre max de tentatives d'envoi d'un rappel avant abandon
REMINDER_MAX_ATTEMPTS=3

# --- Chiffrement du token tenant ---
# Clé AES-256 (32 octets) encodée en base64.
# Génération : python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY_B64=

# --- Mode démo ---
# true = ne contacte JAMAIS l'API Meta (tout reste simulé/logué). Utilisé en dev.
DEMO_MODE=true
# Téléphone utilisé comme destination lors des envois en mode démo
DEMO_PHONE=+212600000000
